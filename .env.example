# App origin. Leave empty until the verified public URL is known.
NEXT_PUBLIC_SITE_URL=""

# Use a unique random value of at least 32 characters in each deployment.
AUTH_SECRET=""

# Only used by `npm run admin:bootstrap` in a private execution environment; not read as an automatic production bootstrap.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# Payment gateway. Keep secrets server-side and use sandbox credentials for testing.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
NEXT_PUBLIC_RAZORPAY_KEY_ID=""

# Optional for local in-memory preview; required in the production runtime for Neon PostgreSQL.
DATABASE_URL=""
